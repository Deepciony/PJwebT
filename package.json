{
  "name": "sporthub",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "trustedDependencies": ["argon2", "esbuild"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "build": "bun --filter web build",
    "start": "bun --filter api start",
    "test": "bun --filter api test",
    "db:migrate": "bun --filter api db:migrate",
    "db:seed": "bun --filter api db:seed",
    "db:reset": "bun --filter api db:reset",
    "db:export": "bun --filter api db:export",
    "db:import": "bun --filter api db:import"
  }
}
